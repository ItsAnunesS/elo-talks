FROM golang:1.26.10-trixie AS go
FROM rust:1.99.1-trixie AS rust
FROM ubuntu:24.04
COPY --from=rust /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 update \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 install -y --no-install-recommends \
    libgtk-4-dev libx11-dev libxdo-dev libnss3 libasound2t64 libgbm1 \
    libatk-bridge2.0-0 libdrm2 libfido2-dev libdbus-1-dev libssl-dev \
    libayatana-appindicator3-dev xvfb xauth xdotool dbus-x11 \
    build-essential file curl git pkg-config python3 ca-certificates black patchelf zsync fuse3 libfuse2t64 squashfs-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
COPY --from=rust /usr/local/cargo/bin /usr/local/cargo/bin
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup
ENV GOPATH=/go
ENV GOCACHE=/go/build-cache
ENV PATH="/usr/local/cargo/bin:/usr/local/go/bin:${PATH}"
ENV CARGO_HOME=/cache/cargo
RUN rustup component add rustfmt clippy
WORKDIR /app
