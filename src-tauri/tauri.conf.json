{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elo Talks",
  "version": "0.1.0",
  "identifier": "dev.anuness.elotalks",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "local-ui"
      ]
    }
  },
  "bundle": {
    "publisher": "AnunesS",
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "externalBin": [
      "helpers/gocryptfs",
      "helpers/bwrap",
      "helpers/xdg-dbus-proxy",
      "helpers/bwrap-real"
    ]
  }
}
